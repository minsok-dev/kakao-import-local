# [변경사유]: 로컬 collector — 시크릿·원본·venv·SQLite 제외
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/

.env
.env.*
!.env.example

*.db
*.db-journal
*.sqlite
*.sqlite3

# 입력·작업 산출물 (원본 경로만 설정으로 가리킴)
input/
data/
output/
*.log

# [변경사유]: 포스터 분류 — 학습 원본 이미지·joblib은 커밋하지 않음
dataset/poster/**
dataset/non_poster/**
!dataset/poster/.gitkeep
!dataset/non_poster/.gitkeep
models/*.joblib
models/active-model.json

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
!docs/
