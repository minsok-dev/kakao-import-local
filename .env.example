# [변경사유]: 로컬 경로·DB·매칭 tolerance
# 입력 루트 (chats/ + photos/)
KAKAO_EXPORT_ROOT=./input/raw

KAKAO_LOCAL_DB=./data/kakao_local.db
LOG_LEVEL=INFO

# Phase1 matcher
MATCH_TOLERANCE_SECONDS=60
GROUP_TEXT_MAX_GAP_MINUTES=30
DIFFERENT_SENDER_GRACE_SECONDS=120
DIFFERENT_SENDER_MAX_CHARS=80

# Phase2 텍스트 merge: safe | balanced | auto
MERGE_MODE=balanced

# Phase3 Import (실전송 시에만). Cookie를 파일로 저장하지 말 것
# KAKAO_IMPORT_ENDPOINT=https://your-host/api/admin/ingest/import/kakao
# KAKAO_IMPORT_SESSION_COOKIE=...
